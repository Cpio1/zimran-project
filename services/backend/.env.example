# Server only. Copy a Postgres URI from Supabase's Connect dialog.
# Leave blank until configured; database operations fail clearly without it.
DATABASE_URL=
# Must match the fixed workspace inserted by migration 0002.
DEMO_WORKSPACE_ID=10000000-0000-4000-8000-000000000000
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Do not put any of these values in frontend NEXT_PUBLIC_* variables.
# Supabase URL / service-role key are not needed for SQL access in Phase 3A.
# Storage credentials will be configured when uploads are implemented.
